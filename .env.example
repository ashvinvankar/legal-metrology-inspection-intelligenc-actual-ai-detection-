# ==============================================================================
# Smart Legal Metrology Compliance Inspection Platform (SLM-CIP)
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Smart Legal Metrology Compliance Inspection Platform"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=slm_admin
POSTGRES_PASSWORD=slm_secure_password
POSTGRES_DB=slm_cip_db
DATABASE_URL=postgresql+asyncpg://slm_admin:slm_secure_password@localhost:5432/slm_cip_db
DATABASE_URL_SYNC=postgresql://slm_admin:slm_secure_password@localhost:5432/slm_cip_db

# Redis & Celery Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / AWS S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=slm-evidence
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000/slm-evidence

# AI / OCR / Rule Engine Thresholds (PRD Section 9.F & Section 10)
OCR_HIGH_CONFIDENCE_THRESHOLD=0.90
OCR_MEDIUM_CONFIDENCE_THRESHOLD=0.60
IMAGE_QUALITY_MIN_SCORE=0.65

# Multimodal Vision AI & Legal Copilot (Google Gemini 3.8 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_VISION_PROVIDER=hybrid

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
